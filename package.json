    "test:e2e": "playwright test",
    "dev:api": "tsx server/dev.ts"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "zod": "^3.25.0",
