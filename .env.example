# Server only. Never use VITE_ for secrets.
YANDEX_API_KEY=
# Service account folder. Needed for YandexGPT's default model URI, not SpeechKit v1 requests.
YANDEX_FOLDER_ID=
# Optional full native model URI; defaults to gpt://<YANDEX_FOLDER_ID>/yandexgpt/latest.
YANDEX_ANALYSIS_MODEL_URI=
YANDEX_SPEECHKIT_LANGUAGE=ru-RU
YANDEX_SPEECHKIT_TOPIC=general
# Per Yandex request, 1000..55000 ms. A repair can make one additional analysis request.
YANDEX_TIMEOUT_MS=55000
YANDEX_ANALYSIS_MAX_TOKENS=8000
# Long audio is NOT enabled by an env switch. A durable async worker and storage are required.
# Optional exact browser origin for your deployed app.
APP_ORIGIN=
# Static assets base; GitHub Pages workflow sets this to /repository-name/.
VITE_BASE_PATH=/
