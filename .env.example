# Server only. Never use VITE_ for secrets.
OPENAI_API_KEY=
# This adapter needs verbose_json + segment timestamps; whisper-1 supports both.
OPENAI_TRANSCRIBE_MODEL=whisper-1
# Model supporting Structured Outputs. Change without editing code.
OPENAI_ANALYSIS_MODEL=gpt-4.1-mini
# Optional exact browser origin for your deployed app.
APP_ORIGIN=
# Static assets base; GitHub Pages workflow sets this to /repository-name/.
VITE_BASE_PATH=/
